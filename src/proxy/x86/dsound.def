; Windows' dsound.dll exports (x86, from Windows 11 build 26300), with their ordinals.
; Ordinal-only exports get a made-up name (tuft_proxy_ordinal_N) that isn't exported.
EXPORTS
    DirectSoundCreate @1
    DirectSoundEnumerateA @2
    DirectSoundEnumerateW @3
    DllCanUnloadNow @4
    DllGetClassObject @5
    DirectSoundCaptureCreate @6
    DirectSoundCaptureEnumerateA @7
    DirectSoundCaptureEnumerateW @8
    GetDeviceID @9
    DirectSoundFullDuplexCreate @10
    DirectSoundCreate8 @11
    DirectSoundCaptureCreate8 @12
