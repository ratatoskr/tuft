// What tuft asks the C# helper it loads into a game's CoreCLR, which has no reflection API for
// native code of its own. Types, fields and methods are the runtime's own handles, the values of
// RuntimeTypeHandle, RuntimeFieldHandle and RuntimeMethodHandle. Assemblies are ids that are never
// used again. 0 is none.
//
// A mod loader can unload what it loaded, and the runtime can put new types, fields and methods
// where they were. A stale handle gives nothing, and what changes points at goes up whenever names
// kept for handles could be wrong, or code that was found could be gone.
trait Reflector {
    // Where a u32 is that goes up, never freed
    usize changes();
    []usize assemblies();
    // Like Assembly-CSharp.dll
    string assemblyName(usize assembly);
    []usize types(usize assembly);
    usize findType(usize assembly, string ns, string name);

    string typeName(usize type);
    // Empty for nested types, like Mono
    string typeNamespace(usize type);
    // Like System.Collections.Generic.List<System.Int32>
    string typeFullName(usize type);
    usize typeParent(usize type);
    // The type it's nested in
    usize typeOuter(usize type);
    usize typeAssembly(usize type);
    // From the object's start, its MethodTable pointer, so value types count that too
    i32 instanceSize(usize type);
    bool isValueType(usize type);
    bool isEnum(usize type);
    usize enumBase(usize type);
    // ECMA-335's ElementType
    u8 elementType(usize type);

    // Its own, not its parents'. Not consts, which the runtime keeps no handle for.
    []usize fields(usize type);
    string fieldName(usize field);
    usize fieldType(usize field);
    usize fieldOwner(usize field);
    // ECMA-335's FieldAttributes
    u32 fieldFlags(usize field);
    // From the object's start, like instanceSize. -1 for statics.
    isize fieldOffset(usize field);
    // Runs its type's static constructor first. 0 if there's no one address, like a thread static.
    usize staticAddress(usize field);

    // Its own and its constructors, not its parents'
    []usize methods(usize type);
    string methodName(usize method);
    []usize paramTypes(usize method);
    usize returnType(usize method);
    usize methodOwner(usize method);
    // ECMA-335's MethodAttributes and MethodImplAttributes
    u32 methodFlags(usize method);
    u32 methodImplFlags(usize method);
    // Where calls to it go, compiled first. 0 for abstract methods and open generics.
    usize methodPointer(usize method);

    // Objects are their addresses, which the garbage collector can move, so each is only good till
    // it next runs. What these give back is kept alive a little while, for the caller to hold.

    // The size of one of its values: its own for value types, a pointer's for references
    u32 typeSize(usize type);
    // this is null for statics, and points at the value for value types. args points at a pointer to
    // each value-type argument, and holds objects as they are. Value results come back boxed. If it
    // throws, exception gets it and this gives 0. A constructor without this makes a new object.
    usize invoke(usize method, usize this, usize args, inout usize exception);
    // value points at the value for value types, and is the object itself for references. Through
    // the runtime, so the garbage collector hears about references.
    void setFieldValue(usize field, usize obj, usize value);
    usize newString(string text);
    // A GCHandle. A pinned one keeps it from moving, which only arrays and strings of plain values allow.
    usize newHandle(usize obj, bool pinned);
    usize handleTarget(usize handle);
    void freeHandle(usize handle);
    // The System.Type
    usize typeObject(usize type);
    usize newArray(usize element, usize length);

    // Assemblies of their own, like a plugin's, each in a load context that can unload. What one depends
    // on is found next to it, and what the default context has, like the runtime's, is shared.

    // Loads the assembly at path, read so the file isn't held. 0 if it couldn't, and loadError says why.
    usize loadIsolated(string path);
    // Why loadIsolated last couldn't
    string loadError();
    // A static [UnmanagedCallersOnly] method of a type in it, by the type's full name, as a pointer to call. 0 if there's none.
    usize isolatedFunction(usize context, string type, string method);
    // Lets it go. What it loaded goes once nothing uses it, and changes goes up then.
    void unloadIsolated(usize context);
}
